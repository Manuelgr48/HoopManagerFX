<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="InformeEquipoJugadores"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20"
              uuid="11111111-2222-3333-4444-555555555555">

    <parameter name="ID_EQUIPO" class="java.lang.Integer"/>
    <parameter name="NOMBRE_EQUIPO" class="java.lang.String"/>

    <queryString>
        <![CDATA[
            SELECT
                j.dorsal,
                j.nombre,
                j.apellidos,
                j.posicion,
                j.altura,
                e.nombre AS equipo
            FROM jugadores j
            INNER JOIN equipos e ON j.id_equipo = e.id_equipo
            WHERE j.id_equipo = $P{ID_EQUIPO}
            ORDER BY j.dorsal
        ]]>
    </queryString>

    <field name="dorsal" class="java.lang.Integer"/>
    <field name="nombre" class="java.lang.String"/>
    <field name="apellidos" class="java.lang.String"/>
    <field name="posicion" class="java.lang.String"/>
    <field name="altura" class="java.math.BigDecimal"/>
    <field name="equipo" class="java.lang.String"/>

    <title>
        <band height="80">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30" uuid="aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Informe de Equipo - HoopManager]]></text>
            </staticText>

            <textField>
                <reportElement x="0" y="40" width="555" height="25" uuid="bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{NOMBRE_EQUIPO}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="30">
            <staticText>
                <reportElement x="0" y="5" width="70" height="20" uuid="cccccccc-cccc-cccc-cccc-cccccccccccc"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Dorsal]]></text>
            </staticText>

            <staticText>
                <reportElement x="70" y="5" width="130" height="20" uuid="dddddddd-dddd-dddd-dddd-dddddddddddd"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Nombre]]></text>
            </staticText>

            <staticText>
                <reportElement x="200" y="5" width="150" height="20" uuid="eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Apellidos]]></text>
            </staticText>

            <staticText>
                <reportElement x="350" y="5" width="120" height="20" uuid="ffffffff-ffff-ffff-ffff-ffffffffffff"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Posicion]]></text>
            </staticText>

            <staticText>
                <reportElement x="470" y="5" width="85" height="20" uuid="99999999-9999-9999-9999-999999999999"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Altura]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="24">
            <textField>
                <reportElement x="0" y="2" width="70" height="20" uuid="11111111-aaaa-bbbb-cccc-111111111111"/>
                <textFieldExpression><![CDATA[$F{dorsal}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="70" y="2" width="130" height="20" uuid="22222222-aaaa-bbbb-cccc-222222222222"/>
                <textFieldExpression><![CDATA[$F{nombre}]]></textField