<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.liceolapaz.mgr.jugadores2ev.hoopmanagerfx.controller.DashboardController"
            style="-fx-background-color: #f4f6f8;">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 14 22; -fx-background-color: #1f2937;">
                <Label text="HoopManager"
                       style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" />

                <Pane HBox.hgrow="ALWAYS" />

                <Button text="Inicio"
                        onAction="#mostrarInicio"
                        style="-fx-background-color: white; -fx-text-fill: #111827; -fx-font-weight: bold; -fx-cursor: hand;" />
            </HBox>

            <HBox fx:id="breadcrumbBar"
                  alignment="CENTER_LEFT"
                  spacing="8"
                  style="-fx-padding: 10 24; -fx-background-color: white; -fx-border-color: #e5e7eb;" />
        </VBox>
    </top>

    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #f4f6f8;" />
    </center>

</BorderPane>