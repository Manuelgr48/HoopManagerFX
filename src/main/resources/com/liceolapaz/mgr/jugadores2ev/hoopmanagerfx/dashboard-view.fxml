<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.liceolapaz.mgr.jugadores2ev.hoopmanagerfx.controller.DashboardController">
    <left>
        <VBox prefWidth="200.0" spacing="15.0" style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="30.0" />
            </padding>
            <Label text="MENÚ" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>
            </Label>
            <Button mnemonicParsing="false" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand;" text="Equipos" />
            <Button mnemonicParsing="false" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand;" text="Jugadores" />
            <Button mnemonicParsing="false" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand;" text="Partidos" />

            <VBox VBox.vgrow="ALWAYS" />

            <Button mnemonicParsing="false" onAction="#handleLogout" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;" text="Cerrar Sesión" />
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER" style="-fx-background-color: #ecf0f1;" BorderPane.alignment="CENTER">
            <Label text="Bienvenido a HoopManagerFX" textFill="#2c3e50">
                <font>
                    <Font name="System Bold" size="36.0" />
                </font>
            </Label>
            <Label text="Selecciona una opción en el menú lateral para empezar" textFill="#7f8c8d">
                <font>
                    <Font size="16.0" />
                </font>
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
            </Label>
        </VBox>
    </center>
</BorderPane>