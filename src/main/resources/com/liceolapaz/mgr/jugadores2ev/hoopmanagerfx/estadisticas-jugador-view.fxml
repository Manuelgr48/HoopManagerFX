<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15"
      style="-fx-padding: 20;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.liceolapaz.mgr.jugadores2ev.hoopmanagerfx.controller.EstadisticasJugadorController">

    <Label fx:id="lblTitulo"
           text="Estadisticas del jugador"
           style="-fx-font-size: 22px; -fx-font-weight: bold;" />

    <TableView fx:id="tablaEstadisticas" prefWidth="760" prefHeight="300">
        <columns>
            <TableColumn fx:id="colRival" text="Equipo Rival" prefWidth="220"/>
            <TableColumn fx:id="colPuntos" text="Puntos" prefWidth="110"/>
            <TableColumn fx:id="colRebotes" text="Rebotes" prefWidth="110"/>
            <TableColumn fx:id="colAsistencias" text="Asistencias" prefWidth="130"/>
            <TableColumn fx:id="colFaltas" text="Faltas" prefWidth="110"/>
        </columns>
    </TableView>

    <HBox fx:id="formularioEstadistica" spacing="10">
        <ComboBox fx:id="cbPartido" promptText="Partido / rival" prefWidth="210"/>
        <TextField fx:id="txtPuntos" promptText="Puntos" prefWidth="90"/>
        <TextField fx:id="txtRebotes" promptText="Rebotes" prefWidth="90"/>
        <TextField fx:id="txtAsistencias" promptText="Asistencias" prefWidth="110"/>
        <TextField fx:id="txtFaltas" promptText="Faltas" prefWidth="90"/>
    </HBox>

    <HBox fx:id="botonesCrud" spacing="10" alignment="CENTER_RIGHT">
        <Button text="Anadir" onAction="#anadirEstadistica" style="-fx-background-color: #2ecc71; -fx-text-fill: white;" />
        <Button text="Modificar" onAction="#modificarEstadistica" style="-fx-background-color: #f39c12; -fx-text-fill: white;" />
        <Button text="Eliminar" onAction="#eliminarEstadistica" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" />
        <Button text="Limpiar" onAction="#limpiarCampos" />
    </HBox>

</VBox>