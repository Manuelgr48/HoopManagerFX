<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15"
      style="-fx-padding: 20;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.liceolapaz.mgr.jugadores2ev.hoopmanagerfx.controller.PartidoInfoController">

    <Label fx:id="lblTitulo" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Label fx:id="lblResultado" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

    <Label text="Nuestro equipo" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1d4ed8;"/>
    <TableView fx:id="tablaPropios" prefHeight="190" style="-fx-border-color: #1d4ed8;">
        <columns>
            <TableColumn fx:id="colJugadorPropio" text="Jugador" prefWidth="220"/>
            <TableColumn fx:id="colPuntosPropio" text="Puntos" prefWidth="90"/>
            <TableColumn fx:id="colRebotesPropio" text="Rebotes" prefWidth="90"/>
            <TableColumn fx:id="colAsistenciasPropio" text="Asistencias" prefWidth="110"/>
            <TableColumn fx:id="colFaltasPropio" text="Faltas" prefWidth="90"/>
        </columns>
    </TableView>

    <Label text="Equipo rival" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #b91c1c;"/>
    <TableView fx:id="tablaRivales" prefHeight="190" style="-fx-border-color: #b91c1c;">
        <columns>
            <TableColumn fx:id="colJugadorRival" text="Jugador" prefWidth="220"/>
            <TableColumn fx:id="colPuntosRival" text="Puntos" prefWidth="90"/>
            <TableColumn fx:id="colRebotesRival" text="Rebotes" prefWidth="90"/>
            <TableColumn fx:id="colAsistenciasRival" text="Asistencias" prefWidth="110"/>
            <TableColumn fx:id="colFaltasRival" text="Faltas" prefWidth="90"/>
        </columns>
    </TableView>

</VBox>