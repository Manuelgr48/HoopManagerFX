<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16"
      style="-fx-padding: 24;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.liceolapaz.mgr.jugadores2ev.hoopmanagerfx.controller.PartidoInfoController">

    <Label fx:id="lblTitulo"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <Label fx:id="lblResultado"
           style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

    <Label fx:id="lblEquipo"
           text="Estadisticas del equipo"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1d4ed8;"/>

    <TableView fx:id="tablaEstadisticas"
               prefWidth="760"
               prefHeight="390"
               style="-fx-border-color: #1d4ed8;">
        <columns>
            <TableColumn fx:id="colJugador" text="Jugador" prefWidth="260"/>
            <TableColumn fx:id="colPuntos" text="Puntos" prefWidth="110"/>
            <TableColumn fx:id="colRebotes" text="Rebotes" prefWidth="110"/>
            <TableColumn fx:id="colAsistencias" text="Asistencias" prefWidth="130"/>
            <TableColumn fx:id="colFaltas" text="Faltas" prefWidth="110"/>
        </columns>
    </TableView>

</VBox>