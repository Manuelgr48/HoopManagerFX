<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="18"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.liceolapaz.mgr.jugadores2ev.hoopmanagerfx.controller.RendimientoController"
      style="-fx-padding: 25;">

    <Label text="Rendimiento"
           style="-fx-font-size: 26px; -fx-font-weight: bold;" />

    <HBox spacing="10">
        <ComboBox fx:id="cbEquipo" promptText="Filtrar por equipo" prefWidth="260" />
        <Button text="Ver todos" onAction="#cargarRendimientoGeneral" />
    </HBox>

    <Label fx:id="lblResumen"
           text="Partidos: 0 | Victorias: 0 | Derrotas: 0 | Empates: 0"
           style="-fx-font-size: 14px; -fx-text-fill: #374151;" />

    <BarChart fx:id="graficoRendimiento" VBox.vgrow="ALWAYS" legendVisible="false">
        <xAxis>
            <CategoryAxis label="Partido" />
        </xAxis>
        <yAxis>
            <NumberAxis label="Diferencia de puntos" />
        </yAxis>
    </BarChart>

</VBox>