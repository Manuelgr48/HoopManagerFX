<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="25"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.liceolapaz.mgr.jugadores2ev.hoopmanagerfx.controller.InicioController"
      style="-fx-padding: 35;">

    <VBox spacing="8">
        <Label fx:id="lblBienvenida"
               text="Bienvenido a HoopManager"
               style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

        <Label fx:id="lblRol"
               text="Rol actual"
               style="-fx-font-size: 15px; -fx-text-fill: #4b5563;" />
    </VBox>

    <HBox spacing="18">
        <VBox spacing="8" prefWidth="190" style="-fx-background-color: white; -fx-padding: 18; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8;">
            <Label text="Equipos" style="-fx-font-size: 15px; -fx-text-fill: #6b7280;" />
            <Label fx:id="lblTotalEquipos" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2563eb;" />
        </VBox>

        <VBox spacing="8" prefWidth="190" style="-fx-background-color: white; -fx-padding: 18; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8;">
            <Label text="Jugadores" style="-fx-font-size: 15px; -fx-text-fill: #6b7280;" />
            <Label fx:id="lblTotalJugadores" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #16a34a;" />
        </VBox>

        <VBox spacing="8" prefWidth="190" style="-fx-background-color: white; -fx-padding: 18; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8;">
            <Label text="Partidos" style="-fx-font-size: 15px; -fx-text-fill: #6b7280;" />
            <Label fx:id="lblTotalPartidos" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #dc2626;" />
        </VBox>
    </HBox>

    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8;">
        <Label text="Resumen de uso"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

        <Label fx:id="lblSugerencia"
               wrapText="true"
               style="-fx-font-size: 15px; -fx-text-fill: #374151;" />

        <Label text="Desde el menu lateral puedes entrar en las tablas generales. Para trabajar por capas, entra en Equipos y abre la informacion de un equipo concreto."
               wrapText="true"
               style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" />
    </VBox>

</VBox>