<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="28"
      alignment="CENTER"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.liceolapaz.mgr.jugadores2ev.hoopmanagerfx.controller.InicioController"
      style="-fx-padding: 42; -fx-background-color: #f4f6f8;">

    <VBox spacing="6" alignment="CENTER">
        <Label fx:id="lblBienvenida"
               text="HoopManager"
               style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

        <Label fx:id="lblRol"
               text="Sesion iniciada"
               style="-fx-font-size: 15px; -fx-text-fill: #6b7280;" />
    </VBox>

    <TilePane hgap="24" vgap="24" prefColumns="2" alignment="CENTER" maxWidth="820">

        <VBox spacing="14" alignment="CENTER" onMouseClicked="#irEquipos" prefWidth="360" prefHeight="215"
              style="-fx-cursor: hand; -fx-background-color: white; -fx-border-color: #2563eb; -fx-border-width: 0 0 6 0; -fx-background-radius: 12; -fx-border-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.16), 14, 0, 0, 5);">

            <StackPane prefWidth="92" prefHeight="92" style="-fx-background-color: #dbeafe; -fx-background-radius: 46;">
                <ImageView fx:id="imgEquipo" fitWidth="66" fitHeight="66" preserveRatio="true" />
            </StackPane>

            <Label text="Equipos" style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
            <Label text="Accede a la informacion de cada equipo" wrapText="true" textAlignment="CENTER"
                   style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
        </VBox>

        <VBox spacing="14" alignment="CENTER" onMouseClicked="#irJugadores" prefWidth="360" prefHeight="215"
              style="-fx-cursor: hand; -fx-background-color: white; -fx-border-color: #16a34a; -fx-border-width: 0 0 6 0; -fx-background-radius: 12; -fx-border-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.16), 14, 0, 0, 5);">

            <StackPane prefWidth="92" prefHeight="92" style="-fx-background-color: #dcfce7; -fx-background-radius: 46;">
                <ImageView fx:id="imgJugador" fitWidth="66" fitHeight="66" preserveRatio="true" />
            </StackPane>

            <Label text="Jugadores" style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
            <Label text="Consulta y gestiona la plantilla" wrapText="true" textAlignment="CENTER"
                   style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
        </VBox>

        <VBox spacing="14" alignment="CENTER" onMouseClicked="#irPartidos" prefWidth="360" prefHeight="215"
              style="-fx-cursor: hand; -fx-background-color: white; -fx-border-color: #dc2626; -fx-border-width: 0 0 6 0; -fx-background-radius: 12; -fx-border-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.16), 14, 0, 0, 5);">

            <StackPane prefWidth="92" prefHeight="92" style="-fx-background-color: #fee2e2; -fx-background-radius: 46;">
                <ImageView fx:id="imgPartido" fitWidth="66" fitHeight="66" preserveRatio="true" />
            </StackPane>

            <Label text="Partidos" style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
            <Label text="Registra rivales, ubicaciones y resultados" wrapText="true" textAlignment="CENTER"
                   style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
        </VBox>

        <VBox fx:id="cardUsuarios" spacing="14" alignment="CENTER" onMouseClicked="#irUsuarios" prefWidth="360" prefHeight="215"
              style="-fx-cursor: hand; -fx-background-color: white; -fx-border-color: #7c3aed; -fx-border-width: 0 0 6 0; -fx-background-radius: 12; -fx-border-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.16), 14, 0, 0, 5);">

            <StackPane prefWidth="92" prefHeight="92" style="-fx-background-color: #ede9fe; -fx-background-radius: 46;">
                <ImageView fx:id="imgUsuario" fitWidth="66" fitHeight="66" preserveRatio="true" />
            </StackPane>

            <Label text="Usuarios" style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
            <Label text="Crea cuentas, asigna roles y vincula equipos" wrapText="true" textAlignment="CENTER"
                   style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
        </VBox>

    </TilePane>

</VBox>