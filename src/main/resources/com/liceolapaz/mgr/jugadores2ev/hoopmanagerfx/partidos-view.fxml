<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15"
      alignment="CENTER"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.liceolapaz.mgr.jugadores2ev.hoopmanagerfx.controller.PartidosController"
      style="-fx-padding: 20;">

    <Label text="Gestion de Partidos" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <TextField fx:id="tfBuscador"
               promptText="Buscar por equipo, rival o ubicacion"
               prefWidth="360"/>

    <TableView fx:id="tablaPartidos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colEquipo" text="Equipo" prefWidth="160"/>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="120"/>
            <TableColumn fx:id="colRival" text="Equipo Rival" prefWidth="150"/>
            <TableColumn fx:id="colUbicacion" text="Ubicacion" prefWidth="150"/>
            <TableColumn fx:id="colResPropio" text="Res. Propio" prefWidth="100"/>
            <TableColumn fx:id="colResRival" text="Res. Rival" prefWidth="100"/>
        </columns>
    </TableView>

    <HBox fx:id="formularioPartido" spacing="10" alignment="CENTER">
        <ComboBox fx:id="cbEquipo" promptText="Equipo" prefWidth="180"/>
        <DatePicker fx:id="dpFecha" promptText="Fecha del partido"/>
        <TextField fx:id="tfRival" promptText="Equipo rival"/>
        <TextField fx:id="tfUbicacion" promptText="Ubicacion"/>
        <TextField fx:id="tfResPropio" promptText="Res. propio" prefWidth="90"/>
        <TextField fx:id="tfResRival" promptText="Res. rival" prefWidth="90"/>
    </HBox>

    <HBox fx:id="botonesCrud" spacing="10" alignment="CENTER">
        <Button text="Anadir" onAction="#handleAnadir" style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
        <Button text="Modificar" onAction="#handleModificar" style="-fx-background-color: #f39c12; -fx-text-fill: white;"/>
        <Button text="Eliminar" onAction="#handleEliminar" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
        <Button text="Limpiar" onAction="#limpiarFormulario"/>
    </HBox>

</VBox>