<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="CENTER"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.liceolapaz.mgr.jugadores2ev.hoopmanagerfx.controller.PartidosController"
      style="-fx-padding: 20;">

    <Label text="Gestion de Partidos" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <TableView fx:id="tablaPartidos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colEquipo" text="Equipo" prefWidth="150"/>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="120"/>
            <TableColumn fx:id="colRival" text="Equipo Rival" prefWidth="150"/>
            <TableColumn fx:id="colUbicacion" text="Ubicacion" prefWidth="150"/>
            <TableColumn fx:id="colResPropio" text="Res. Propio" prefWidth="100"/>
            <TableColumn fx:id="colResRival" text="Res. Rival" prefWidth="100"/>
        </columns>
    </TableView>

    <HBox fx:id="formularioPartido" spacing="10" alignment="CENTER">
        <TextField fx:id="tfEquipo" promptText="Equipo propio"/>
        <DatePicker fx:id="dpFecha" promptText="Fecha del partido"/>
        <TextField fx:id="tfRival" promptText="Equipo Rival"/>
        <TextField fx:id="tfUbicacion" promptText="Ubicacion"/>
        <TextField fx:id="tfResPropio" promptText="Resultado Propio" prefWidth="120"/>
        <TextField fx:id="tfResRival" promptText="Resultado Rival" prefWidth="120"/>
    </HBox>

    <HBox fx:id="botonesCrud" spacing="15" alignment="CENTER">
        <Button fx:id="btnAnadir"
                text="Anadir Partido"
                onAction="#handleAnadir"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>

        <Button fx:id="btnModificar"
                text="Modificar Partido"
                onAction="#handleModificar"
                style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>

        <Button fx:id="btnEliminar"
                text="Eliminar Partido"
                onAction="#handleEliminar"
                style="-fx-background-color: #f44336; -fx-text-fill: white;"/>

        <Button text="Limpiar Formulario"
                onAction="#limpiarFormulario"/>
    </HBox>

</VBox>