<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="550.0" prefWidth="850.0" spacing="15.0" style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.liceolapaz.mgr.jugadores2ev.hoopmanagerfx.controller.EquiposController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Equipos" textFill="#2c3e50">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>

    <TableView fx:id="tablaEquipos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre" />
            <TableColumn fx:id="colCategoria" prefWidth="120.0" text="Categoria" />
            <TableColumn fx:id="colPresupuesto" prefWidth="120.0" text="Presupuesto" />
            <TableColumn fx:id="colFechaCreacion" prefWidth="120.0" text="Fecha Creacion" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="btnAccederInformacion" text="Acceder a informacion" onAction="#accederInformacionEquipo" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;" />
    </HBox>

    <GridPane fx:id="formularioEquipo" hgap="10" vgap="10">
        <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="tfNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Categoria:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="tfCategoria" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Presupuesto:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <TextField fx:id="tfPresupuesto" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <Label text="Fecha Creacion:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <DatePicker fx:id="dpFechaCreacion" GridPane.columnIndex="3" GridPane.rowIndex="1" />
    </GridPane>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="btnAnadir" text="Anadir Equipo" onAction="#handleAnadir" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" />
        <Button fx:id="btnModificar" text="Modificar" onAction="#handleModificar" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold;" />
        <Button fx:id="btnEliminar" text="Eliminar" onAction="#handleEliminar" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" />
        <Button text="Limpiar" onAction="#limpiarFormulario" />
    </HBox>
</VBox>