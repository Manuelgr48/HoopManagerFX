<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15"
      alignment="CENTER"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.liceolapaz.mgr.jugadores2ev.hoopmanagerfx.controller.EquiposController"
      style="-fx-padding: 20;">

    <Label text="Gestion de Equipos" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="tfBuscador" promptText="Buscar por nombre o categoria" prefWidth="320"/>
        <Button text="Limpiar" onAction="#limpiarFormulario"/>
    </HBox>

    <TableView fx:id="tablaEquipos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180"/>
            <TableColumn fx:id="colCategoria" text="Categoria" prefWidth="140"/>
            <TableColumn fx:id="colPresupuesto" text="Presupuesto" prefWidth="120"/>
            <TableColumn fx:id="colFechaCreacion" text="Fecha creacion" prefWidth="140"/>
        </columns>
    </TableView>

    <Button fx:id="btnAccederInformacion"
            text="Acceder a informacion"
            onAction="#accederInformacionEquipo"
            style="-fx-background-color: #2563eb; -fx-text-fill: white;"/>

    <GridPane fx:id="formularioEquipo" hgap="10" vgap="10" alignment="CENTER">
        <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="tfNombre" promptText="Nombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Categoria:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="tfCategoria" promptText="Categoria" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Presupuesto:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="tfPresupuesto" promptText="Presupuesto" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Fecha creacion:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dpFechaCreacion" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="btnAnadir" text="Anadir" onAction="#handleAnadir" style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
        <Button fx:id="btnModificar" text="Modificar" onAction="#handleModificar" style="-fx-background-color: #f39c12; -fx-text-fill: white;"/>
        <Button fx:id="btnEliminar" text="Eliminar" onAction="#handleEliminar" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
        <Button text="Limpiar" onAction="#limpiarFormulario"/>
    </HBox>

</VBox>