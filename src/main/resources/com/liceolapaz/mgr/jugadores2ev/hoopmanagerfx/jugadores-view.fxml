<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="550.0"
      prefWidth="850.0"
      spacing="15.0"
      style="-fx-background-color: #ecf0f1;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.liceolapaz.mgr.jugadores2ev.hoopmanagerfx.controller.JugadoresController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="lblTitulo" text="Gestion de Jugadores" textFill="#2c3e50">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>

    <TextField fx:id="tfBuscador"
               promptText="Buscar por nombre, apellidos o equipo..."
               style="-fx-font-size: 14px; -fx-padding: 8px;" />

    <TableView fx:id="tablaJugadores" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="120.0" text="Nombre" />
            <TableColumn fx:id="colApellidos" prefWidth="150.0" text="Apellidos" />
            <TableColumn fx:id="colDorsal" prefWidth="70.0" text="Dorsal" />
            <TableColumn fx:id="colPosicion" prefWidth="100.0" text="Posicion" />
            <TableColumn fx:id="colAltura" prefWidth="80.0" text="Altura" />
            <TableColumn fx:id="colEquipo" prefWidth="150.0" text="Equipo" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="btnVerInformacion"
                text="Ver informacion del jugador"
                onAction="#verInformacionJugador"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;" />
    </HBox>

    <GridPane fx:id="formularioJugador" hgap="10" vgap="10">
        <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Apellidos:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <TextField fx:id="txtApellidos" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <Label text="Dorsal:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtDorsal" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Posicion:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <TextField fx:id="txtPosicion" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <Label text="Altura:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtAltura" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Equipo:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
        <ComboBox fx:id="cbEquipo"
                  promptText="Sin equipo"
                  prefWidth="220.0"
                  GridPane.columnIndex="3"
                  GridPane.rowIndex="2" />
    </GridPane>

    <HBox fx:id="botonesCrud" alignment="CENTER_RIGHT" spacing="10.0">
        <Button text="Anadir" onAction="#anadirJugador" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" />
        <Button text="Modificar" onAction="#modificarJugador" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold;" />
        <Button text="Eliminar" onAction="#eliminarJugador" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" />
        <Button text="Limpiar" onAction="#limpiarCampos" />
    </HBox>
</VBox>