<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox spacing="15.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.liceolapaz.mgr.jugadores2ev.hoopmanagerfx.controller.UsuariosController">

    <Label text="Gestión de Usuarios (Panel de Administrador)" textFill="#2c3e50">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>

    <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colIdUsuario" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="colUsername" prefWidth="150.0" text="Usuario" />
            <TableColumn fx:id="colRol" prefWidth="120.0" text="Rol" />
            <TableColumn fx:id="colIdEquipo" prefWidth="150.0" text="ID Equipo Asignado" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-background-color: #ecf0f1; -fx-padding: 15; -fx-border-radius: 5; -fx-background-radius: 5;">
        <VBox spacing="5.0">
            <Label text="Cambiar Rol:" />
            <ComboBox fx:id="cbRol" prefWidth="150.0">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="JUGADOR" />
                        <String fx:value="ENTRENADOR" />
                        <String fx:value="ADMIN" />
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>

        <VBox spacing="5.0">
            <Label text="Asignar Equipo (ID):" />
            <TextField fx:id="txtIdEquipo" promptText="Dejar vacío si no tiene" prefWidth="150.0" />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <Button text="💾 Guardar Cambios" onAction="#actualizarUsuario" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;" />
        <Button text="🗑️ Eliminar Usuario" onAction="#eliminarUsuario" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" />
    </HBox>
    <Label fx:id="lblMensaje" textFill="green" />
</VBox>